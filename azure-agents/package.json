{
  "name": "azure-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Azure DevOps-native platform where agents work the items developers assign to themselves",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "dev:ui": "vite ui",
    "build": "tsc -p server && vite build ui",
    "start": "node server/dist/index.js",
    "migrate": "tsx server/src/db/migrate.ts",
    "typecheck": "tsc -p server --noEmit && tsc -p ui --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.0",
    "@fastify/static": "^9.0.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
